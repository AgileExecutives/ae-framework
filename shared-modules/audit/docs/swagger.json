{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/audit/entity/{entity_type}/{entity_id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieve complete audit trail for a specific entity (e.g., all changes to an invoice)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "audit"
                ],
                "summary": "Get audit logs for a specific entity",
                "operationId": "getEntityAuditLogs",
                "parameters": [
                    {
                        "enum": [
                            "invoice",
                            "invoice_item",
                            "session",
                            "extra_effort"
                        ],
                        "type": "string",
                        "example": "invoice",
                        "description": "Entity type",
                        "name": "entity_type",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "example": 123,
                        "description": "Entity ID",
                        "name": "entity_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/entities.AuditLogListResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/audit/export": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Export audit logs in CSV format for tax authority compliance (GoBD). Supports same filtering options as GET /audit/logs.",
                "produces": [
                    "text/csv"
                ],
                "tags": [
                    "audit"
                ],
                "summary": "Export audit logs to CSV",
                "operationId": "exportAuditLogs",
                "parameters": [
                    {
                        "type": "integer",
                        "example": 1,
                        "description": "Filter by user ID",
                        "name": "user_id",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "invoice",
                            "invoice_item",
                            "session",
                            "extra_effort"
                        ],
                        "type": "string",
                        "example": "invoice",
                        "description": "Filter by entity type",
                        "name": "entity_type",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "example": 123,
                        "description": "Filter by entity ID",
                        "name": "entity_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "invoice_finalized",
                        "description": "Filter by action",
                        "name": "action",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2026-01-01T00:00:00Z",
                        "description": "Filter by start date (RFC3339)",
                        "name": "start_date",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2026-12-31T23:59:59Z",
                        "description": "Filter by end date (RFC3339)",
                        "name": "end_date",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "CSV file download",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/audit/logs": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieve audit logs with optional filtering by user, entity, action, and date range. Supports pagination.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "audit"
                ],
                "summary": "Get audit logs",
                "operationId": "getAuditLogs",
                "parameters": [
                    {
                        "type": "integer",
                        "example": 1,
                        "description": "Filter by user ID",
                        "name": "user_id",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "invoice",
                            "invoice_item",
                            "session",
                            "extra_effort"
                        ],
                        "type": "string",
                        "example": "invoice",
                        "description": "Filter by entity type",
                        "name": "entity_type",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "example": 123,
                        "description": "Filter by entity ID",
                        "name": "entity_id",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "invoice_draft_created",
                            "invoice_draft_updated",
                            "invoice_draft_cancelled",
                            "invoice_finalized",
                            "invoice_sent",
                            "invoice_marked_paid",
                            "invoice_marked_overdue",
                            "reminder_sent",
                            "credit_note_created",
                            "xrechnung_exported"
                        ],
                        "type": "string",
                        "example": "invoice_finalized",
                        "description": "Filter by action",
                        "name": "action",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2026-01-01T00:00:00Z",
                        "description": "Filter by start date (RFC3339)",
                        "name": "start_date",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2026-12-31T23:59:59Z",
                        "description": "Filter by end date (RFC3339)",
                        "name": "end_date",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "example": 1,
                        "description": "Page number (default: 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "example": 50,
                        "description": "Items per page (default: 50, max: 100)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/entities.AuditLogListResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/audit/statistics": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieve aggregated statistics for audit logs (action counts, user activity, entity type distribution). Returns statistics including total logs, action counts, user activity, and entity type distribution.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "audit"
                ],
                "summary": "Get audit statistics",
                "operationId": "getAuditStatistics",
                "parameters": [
                    {
                        "type": "string",
                        "example": "2026-01-01T00:00:00Z",
                        "description": "Statistics start date (RFC3339)",
                        "name": "start_date",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2026-12-31T23:59:59Z",
                        "description": "Statistics end date (RFC3339)",
                        "name": "end_date",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Audit statistics with action_counts, user_activity, entity_type_counts, total_logs, date_range",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "entities.AuditAction": {
            "type": "string",
            "enum": [
                "invoice_draft_created",
                "invoice_draft_updated",
                "invoice_draft_cancelled",
                "invoice_finalized",
                "invoice_sent",
                "invoice_marked_paid",
                "invoice_marked_overdue",
                "reminder_sent",
                "credit_note_created",
                "xrechnung_exported"
            ],
            "x-enum-varnames": [
                "AuditActionInvoiceDraftCreated",
                "AuditActionInvoiceDraftUpdated",
                "AuditActionInvoiceDraftCancelled",
                "AuditActionInvoiceFinalized",
                "AuditActionInvoiceSent",
                "AuditActionInvoiceMarkedPaid",
                "AuditActionInvoiceMarkedOverdue",
                "AuditActionReminderSent",
                "AuditActionCreditNoteCreated",
                "AuditActionXRechnungExported"
            ]
        },
        "entities.AuditLogListResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/entities.AuditLogResponse"
                    }
                },
                "limit": {
                    "type": "integer"
                },
                "message": {
                    "type": "string"
                },
                "page": {
                    "type": "integer"
                },
                "success": {
                    "type": "boolean"
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "entities.AuditLogResponse": {
            "type": "object",
            "properties": {
                "action": {
                    "$ref": "#/definitions/entities.AuditAction"
                },
                "created_at": {
                    "type": "string"
                },
                "entity_id": {
                    "type": "integer"
                },
                "entity_type": {
                    "$ref": "#/definitions/entities.EntityType"
                },
                "id": {
                    "type": "integer"
                },
                "ip_address": {
                    "type": "string"
                },
                "metadata": {
                    "type": "object",
                    "additionalProperties": true
                },
                "tenant_id": {
                    "type": "integer"
                },
                "user_agent": {
                    "type": "string"
                },
                "user_id": {
                    "type": "integer"
                }
            }
        },
        "entities.EntityType": {
            "type": "string",
            "enum": [
                "invoice",
                "invoice_item",
                "session",
                "extra_effort"
            ],
            "x-enum-varnames": [
                "EntityTypeInvoice",
                "EntityTypeInvoiceItem",
                "EntityTypeSession",
                "EntityTypeExtraEffort"
            ]
        },
        "handlers.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "detailed error message"
                },
                "message": {
                    "type": "string",
                    "example": "Unauthorized"
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        }
    }
}