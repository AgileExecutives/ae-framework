                ],
                "tags": [
                    "Invoice Numbers"
                ],
                "summary": "Get invoice number history",
                "operationId": "getInvoiceNumberHistory",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Organization ID",
                        "name": "organization_id",
