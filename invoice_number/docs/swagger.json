            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Generate the next sequential invoice number using organization settings (prefix, next number)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Invoice Numbers"
                ],
                "summary": "Generate next invoice number from settings",
