        "/invoice-numbers/void": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Mark an invoice number as voided in the audit log",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Invoice Numbers"
                ],
                "summary": "Void invoice number",
                "operationId": "voidInvoiceNumber",
                "parameters": [
                    {
                        "description": "Invoice number to void",
                        "name": "request",
                        "in": "body",
                        "required": true,
