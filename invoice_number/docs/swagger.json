                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Invoice Numbers"
                ],
                "summary": "Generate next invoice number",
                "operationId": "generateInvoiceNumber",
                "parameters": [
                    {
                        "description": "Invoice number configuration",
                        "name": "request",
                        "in": "body",
                        "required": true,
